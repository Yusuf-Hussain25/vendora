# ---------------------------------------------------------------- database
# Neon: console.neon.tech → your project → Connect.
# DATABASE_URL = the "Pooled connection" string, DIRECT_URL = the same string with
# the pooler toggle off (used by `prisma db push`). Any Postgres works locally.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------- auth (Better Auth)
# Any long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional "Continue with Google". Google Cloud Console → APIs & Services → Credentials →
# Create OAuth client ID (Web). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------- store
# ISO currency code used for prices and Stripe. Vendora is built for India: INR
NEXT_PUBLIC_CURRENCY="INR"

# ---------------------------------------------------------------- image uploads
# cloudinary = upload from the browser with an unsigned preset (no secret needed)
# url        = sellers paste image URLs (works with zero setup)
NEXT_PUBLIC_UPLOAD_PROVIDER="url"
# Cloudinary console → Settings → Upload → Upload presets → Add → Signing mode: Unsigned
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="vendora_unsigned"

# ---------------------------------------------------------------- payments (optional)
# Stripe dashboard (test mode) → Developers → API keys → Secret key.
# Card checkout is hidden when this is empty; cash on delivery always works.
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks → endpoint <APP_URL>/api/stripe/webhook (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------- AI listing assistant (optional)
# Any OpenAI-compatible endpoint. Free option: Google AI Studio → Get API key (Gemini).
# The "Write with AI" button is hidden when AI_API_KEY is empty.
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------- demo data (npm run seed)
# The login page shows "Explore with a demo account" when the email and password are set.
# Optional admin and rider demo logins share the demo password.
NEXT_PUBLIC_DEMO_EMAIL="demo@vendora-demo.dev"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin.demo@vendora-demo.dev"
NEXT_PUBLIC_DEMO_RIDER_EMAIL="rider.demo@vendora-demo.dev"
NEXT_PUBLIC_DEMO_PASSWORD=""
# Password for the other seeded shoppers, sellers and riders
SEED_PASSWORD=""
# Marketplace admin account created by the seeder
ADMIN_EMAIL="admin@vendora-demo.dev"
ADMIN_PASSWORD=""
